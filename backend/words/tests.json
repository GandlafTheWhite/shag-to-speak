{
  "tests": [
    {
      "name": "OPTIONS for CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get user words",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-User-Id": "1"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "words": "array"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check spelling only (without adding)",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-User-Id": "1"
      },
      "body": {
        "words": ["hello"],
        "check_only": true
      },
      "expectedStatus": 200,
      "expectedBody": {
        "corrections": "array",
        "enriched_data": "object"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Add new words with spell-check and enrichment",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-User-Id": "1"
      },
      "body": {
        "words": ["world"],
        "check_only": false
      },
      "expectedStatus": 200,
      "expectedBody": {
        "words": "array",
        "count": "number"
      },
      "bodyMatcher": "partial"
    }
  ]
}