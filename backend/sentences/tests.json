{
  "tests": [
    {
      "name": "Get user sentences",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-User-Id": "1"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "sentences": "array"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Add new sentence",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-User-Id": "1"
      },
      "body": {
        "text": "break the ice"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "sentence": {
          "id": "number",
          "english_text": "string",
          "russian_translation": "string"
        }
      },
      "bodyMatcher": "partial"
    }
  ]
}
