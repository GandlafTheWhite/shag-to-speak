{
  "tests": [
    {
      "name": "Update theme via PUT",
      "method": "PUT",
      "path": "/",
      "body": {
        "user_id": 1,
        "theme": "dark",
        "onboarding_completed": true
      },
      "expectedStatus": 200
    },
    {
      "name": "Update exercise difficulty",
      "method": "POST",
      "path": "/",
      "body": {
        "user_id": 1,
        "exercise_difficulty": "intermediate"
      },
      "expectedStatus": 200
    },
    {
      "name": "Fail without user ID",
      "method": "POST",
      "path": "/",
      "body": {
        "exercise_difficulty": "advanced"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}